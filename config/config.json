{
  "version": "1.0",
  "description": "Configuration des regles pour Index, Tenor et Sous-Portefeuilles dans RBM_Tool",
  
  "rules": {
    "Index": {
      "description": "Regles de validation et gestion des Index",
      
      "allowed_indexes": [
        "Estr",
        "EONIA",
        "Euribor1M",
        "Euribor3M",
        "Euribor6M",
        "Euribor12M",
        "Sonia", 
        "IPCGBP",
        "SOFR",
        "FEDFUNDS"
      ],
      
      "case_sensitive": false,
      "normalize_case": "upper",
      
      "aliases": {
        "EURIBOR1M": "Euribor1M",
        "EURIBOR3M": "Euribor3M",
        "EURIBOR6M": "Euribor6M",
        "EURIBOR12M": "Euribor12M",
        "ESTR": "Estr",
        "EONIA": "Estr",
        "SONIA": "Sonia",
        "UKRPI":"IPCGBP",
        "SOFR": "SOFR",
        "FEDFUND": "FEDFUNDS"
      },
      
      "validation": {
        "required": true,
        "allow_unknown": false,
        "warn_on_unknown": true,
        "default_on_unknown": null
      },
      
      "grouping_rules": {
        "enable": false,
        "groups": {
          "EU_RATES": ["Estr", "Euribor1M","Euribor3M","Euribor6M","Euribor12M", "EONIA"],
          "UK_RATES": ["Sonia","IPCGBP"],
          "US_RATES": ["SOFR", "FEDFUNDS"]
        }
      }
    },
    
    "Tenor": {
      "description": "Regles de validation et gestion des Tenors",
      
      "allowed_tenors": [
        "ON",
        "TN", 
        "SN", 
        "SW",
        "1W",
        "2W",
        "3W",
        "1M",
        "2M",
        "3M",
        "4M",
        "5M",
        "6M",
        "7M",
        "8M",
        "9M",
        "10M",
        "11M",
        "12M",
        "1Y",
        "2Y",
        "3Y",
        "4Y",
        "5Y",
        "6Y",
        "7Y",
        "8Y",
        "9Y",
        "10Y",
        "12Y",
        "15Y",
        "20Y",
        "25Y",
        "30Y",
        "40Y",
        "50Y"
      ],
      
      "case_sensitive": false,
      "normalize_case": "upper",
      
      "aliases": {
        "O/N": "ON",
        "T/N": "TN",
        "S/N": "SN",
        "SW": "1W",
        "1 Week": "1W",
        "2 Weeks": "2W",
        "3 Weeks": "3W",
        "1 Month": "1M",
        "2 Months": "2M",
        "3 Months": "3M",
        "6 Months": "6M",
        "9 Months": "9M",
        "12 Months": "12M",
        "1 Year": "1Y",
        "2 Years": "2Y",
        "5 Years": "5Y",
        "10 Years": "10Y"
      },
      
      "validation": {
        "required": true,
        "allow_unknown": false,
        "warn_on_unknown": true,
        "default_on_unknown": null
      },
      
      "conversion": {
        "enable": true,
        "months_to_years": {
          "12M": "1Y",
          "24M": "2Y",
          "36M": "3Y",
          "60M": "5Y",
          "120M": "10Y"
        },
        "weeks_to_months": {
          "4W": "1M",
          "8W": "2M",
          "12W": "3M",
          "26W": "6M",
          "52W": "1Y"
        }
      },
      
      "sorting": {
        "order": [
          "ON", "TN", "SN",
          "1W", "2W", "3W",
          "1M", "2M", "3M", "4M", "5M", "6M", "7M", "8M", "9M", "10M", "11M", "12M",
          "1Y", "2Y", "3Y", "4Y", "5Y", "6Y", "7Y", "8Y", "9Y", "10Y",
          "12Y", "15Y", "20Y", "25Y", "30Y", "40Y", "50Y"
        ]
      }
    },
    
    "SubPortfolio": {
      "description": "Regles de creation et gestion des Sous-Portefeuilles",
      
      "naming_convention": {
        "format": "{CCY}_{PricingModel}_{Way}",
        "separator": "_",
        "case": "preserve"
      },
      
      "grouping": {
        "primary_key": ["CCY", "PricingModel", "Way"],
        "secondary_grouping": {
          "enable": false,
          "by_index": false,
          "by_tenor": false
        }
      },
      
      "specific_subportfolios": {
        "description": "Sous-portefeuilles specifiques avec regles particuleres",
        
        "rules": [
          {
            "name": "EUR_Inflation_Pay",
            "criteria": {
              "CCY": ["EUR"],
              "PricingModel": ["Inflation"],
              "Way": ["Pay"]
            },
            "priority": 1,
            "matching_rules": {
              "preferred_indexes": ["Estr", "Euribor"],
              "excluded_indexes": [],
              "min_sensitivity_threshold": 0.01,
              "max_usage_percentage": 1.0
            },
            "excluded": false
          },
          {
            "name": "EUR_Inflation_Rec",
            "criteria": {
              "CCY": ["EUR"],
              "PricingModel": ["Inflation"],
              "Way": ["Rec"]
            },
            "priority": 1,
            "matching_rules": {
              "preferred_indexes": ["Estr", "Euribor"],
              "excluded_indexes": [],
              "min_sensitivity_threshold": 0.01,
              "max_usage_percentage": 1.0
            },
            "excluded": false
          },
          {
            "name": "GBP_Discounting_Pay",
            "criteria": {
              "CCY": ["GBP"],
              "PricingModel": ["Discounting"],
              "Way": ["Pay"]
            },
            "priority": 2,
            "matching_rules": {
              "preferred_indexes": ["Sonia"],
              "excluded_indexes": [],
              "min_sensitivity_threshold": 0.01,
              "max_usage_percentage": 1.0
            },
            "excluded": false
          },
          {
            "name": "GBP_Discounting_Rec",
            "criteria": {
              "CCY": ["GBP"],
              "PricingModel": ["Discounting"],
              "Way": ["Rec"]
            },
            "priority": 2,
            "matching_rules": {
              "preferred_indexes": ["Sonia"],
              "excluded_indexes": [],
              "min_sensitivity_threshold": 0.01,
              "max_usage_percentage": 1.0
            },
            "excluded": false
          }
        ],
        
        "exclusion_rules": {
          "by_external_party": {
            "enable": false,
            "excluded_parties": ["CLFRFRPP", "FSA"]
          },
          "by_trade_type": {
            "enable": false,
            "excluded_types": []
          },
          "by_size": {
            "enable": false,
            "min_mtm": 0,
            "max_mtm": null
          }
        }
      },
      
      "matching": {
        "description": "Regles de matching pour les sous-portefeuilles",
        
        "algorithm": {
          "type": "iterative",
          "max_iterations": 100,
          "tolerance": 1000.0
        },
        
        "selection_criteria": {
          "primary": "Gpt_Id",
          "sort_order": "descending",
          "fallback": "TranNum"
        },
        
        "sensitivity_matching": {
          "require_opposite_signs": true,
          "matching_tolerance": 1000.0,
          "usage_calculation": "proportional"
        },
        
        "cross_currency_matching": {
          "allow": false,
          "conversion_rates": {}
        },
        
        "cross_pricing_model_matching": {
          "allow": false
        }
      },
      
      "aggregation": {
        "description": "Regles d'agregation des sensibilites",
        
        "method": "sum",
        "group_by": ["Index", "Tenor"],
        
        "initial_sensitivity": {
          "include": true,
          "description": "Sensibilites initiales avant matching"
        },
        
        "total_sensitivity": {
          "include": true,
          "description": "Sensibilites courantes pendant le matching"
        },
        
        "remaining_sensitivity": {
          "include": true,
          "description": "Sensibilites restantes apres matching"
        }
      }
    }
  },
  
  "InternalTrades": {
    "description": "Regles pour l'identification des trades internes",
    
    "identification": {
      "external_party_patterns": ["CLF.*", "FSA.*"],
      "case_sensitive": false,
      "use_regex": true
    },
    
    "validation": {
      "require_matching_sensitivity": true,
      "require_matching_pnl": true
    }
  },
  
  "ExternalTrades": {
    "description": "Regles pour l'identification des trades externes",
    
    "identification": {
      "method": "inverse_of_internal",
      "excluded_patterns": ["CLF.*", "FSA.*"]
    },
    
    "usage_limits": {
      "max_usage_per_trade": 1.0,
      "allow_partial_usage": true,
      "min_usage_increment": 0.01
    }
  },
  
  "Output": {
    "description": "Regles pour la generation des outputs",
    
    "formats": {
      "Internal_SubPortfolios": {
        "include_columns": ["SubPortfolio", "Index", "Tenor", "Delta"],
        "sort_by": ["SubPortfolio", "Index", "Tenor"],
        "decimal_places": 2
      },
      "Matched_Trades": {
        "include_columns": ["SubPortfolio", "External_TranNum", "External_Usage_Percentage", "Reduction"],
        "sort_by": ["SubPortfolio", "External_TranNum"],
        "decimal_places": 4
      },
      "External_Usage": {
        "include_columns": ["TranNum", "InsNum", "ExternalParty", "CCY", "PricingModel", "Way", "Usage_Percentage"],
        "sort_by": ["TranNum"],
        "decimal_places": 4
      },
      "Unmatched_Sensitivities": {
        "include_columns": ["SubPortfolio", "Index", "Tenor", "Delta"],
        "sort_by": ["SubPortfolio", "Index", "Tenor"],
        "decimal_places": 2
      }
    },
    
    "separator": ";",
    "decimal_separator": ".",
    "encoding": "utf-8",
    
    "include_summary": true,
    "include_detailed_files": true
  },
  
  "Validation": {
    "description": "Regles de validation globales",
    
    "required_files": ["GT_Valo.csv", "Rep_Sensi.csv", "Offsetting.csv"],
    
    "consistency_checks": {
      "trades_must_have_sensitivities": true,
      "trades_must_have_pnl": true,
      "warn_on_orphan_sensitivities": true,
      "warn_on_orphan_pnl": true
    },
    
    "data_quality": {
      "check_duplicates": {
        "TranNum": true,
        "InsNum": false
      },
      "null_handling": {
        "TranNum": "error",
        "Index": "warn",
        "Tenor": "warn",
        "Delta": "warn"
      }
    }
  }
}
